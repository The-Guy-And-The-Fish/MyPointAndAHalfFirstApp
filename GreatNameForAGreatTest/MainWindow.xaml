<Window x:Class="GreatNameForAGreatTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreatNameForAGreatTest"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="580" ResizeMode="NoResize">
    <Grid>
        <!--GRID SETTINGS-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,25">
            <TextBlock x:Name="WelcomeTxt" Text="Welcome!" FontSize="15" Padding="4,2" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Red"/>
            <TextBlock Text="Enter Your Name:" FontSize="15" Padding="4,2"/>
            <TextBox x:Name="NameTxt" Margin="0,6,0,6"/>
            <Button x:Name="GreetingsBTN" Content="Greetings!" FontSize="14" Margin="0,0,0,6" Click="GreetingsBTN_Click"/>
            <Button x:Name="OpenBTN" Content="Open Second Window" FontSize="14" Click="OpenBTN_Click"/>
        </StackPanel>
    </Grid>
</Window>
